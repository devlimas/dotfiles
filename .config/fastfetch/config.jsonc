{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "$HOME/.config/fastfetch/arch.txt",
    	"padding": {
    		"top": 4,
            "right": 2,
            "left": 2
    	},
    },
    "display": {
        "separator": "➔ "
    },
    "modules": [
        {
            "type": "title",
            "format": " {6}{7}{8}"
        },
        {
            "type": "colors",
            "paddingLeft": 34,
            "symbol": "circle",
            "block": {
                "width": 10
            }
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "  ",
            "keyColor": "34",
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "34",
        },
        {
            "type": "packages",
            "key": " ├  ",
            "keyColor": "34",
        },
        {
            "type": "shell",
            "key": " ├  ",
            "keyColor": "34",
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "34",
        },
        {
            "type": "media",
            "key": " ├ 󰐌 ",
            "keyColor": "34",
        },
        {
            "type": "wm",
            "key": " └  ",
            "keyColor": "34",
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────────────────────────────────────┐"
        },
        {
            "type": "cpu",
            "key": " 󰍛 ",
            "keyColor": "34",
        },
        {
            "type": "memory",
            "key": " ├ 󰇖 ",
            "keyColor": "34",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "34",
        },
        {
            "type": "disk",
            "folders": ["/"],
            "key": " ├ 󰋊 raiz ",
            "keyColor": "34"
        },
        {
            "type": "disk",
            "folders": ["/home"],
            "key": " └ 󰋊 home ",
            "keyColor": "34"
        }
        ,
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 34,
            "symbol": "circle",
            "block": {
                "width": 10
            }
        }
    ]
}