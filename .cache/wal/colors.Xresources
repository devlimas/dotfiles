! X colors.
! Generated by 'wal'
*foreground:        #e1dfcf
*background:        #161213
*.foreground:       #e1dfcf
*.background:       #161213
emacs*foreground:   #e1dfcf
emacs*background:   #161213
URxvt*foreground:   #e1dfcf
XTerm*foreground:   #e1dfcf
UXTerm*foreground:  #e1dfcf
URxvt*background:   [100]#161213
XTerm*background:   #161213
UXTerm*background:  #161213
URxvt*cursorColor:  #e1dfcf
XTerm*cursorColor:  #e1dfcf
UXTerm*cursorColor: #e1dfcf
URxvt*borderColor:  [100]#161213

! Colors 0-15.
*.color0: #161213
*color0:  #161213
*.color1: #7F8072
*color1:  #7F8072
*.color2: #7A837B
*color2:  #7A837B
*.color3: #88813B
*color3:  #88813B
*.color4: #8F8B74
*color4:  #8F8B74
*.color5: #8F9689
*color5:  #8F9689
*.color6: #A9AB98
*color6:  #A9AB98
*.color7: #e1dfcf
*color7:  #e1dfcf
*.color8: #9d9c90
*color8:  #9d9c90
*.color9: #7F8072
*color9:  #7F8072
*.color10: #7A837B
*color10:  #7A837B
*.color11: #88813B
*color11:  #88813B
*.color12: #8F8B74
*color12:  #8F8B74
*.color13: #8F9689
*color13:  #8F9689
*.color14: #A9AB98
*color14:  #A9AB98
*.color15: #e1dfcf
*color15:  #e1dfcf

! Black color that will not be affected by bold highlighting.
*.color66: #161213
*color66:  #161213

! Xclock colors.
XClock*foreground: #e1dfcf
XClock*background: #161213
XClock*majorColor:  rgba:e1/df/cf/ff
XClock*minorColor:  rgba:e1/df/cf/ff
XClock*hourColor:   rgba:e1/df/cf/ff
XClock*minuteColor: rgba:e1/df/cf/ff
XClock*secondColor: rgba:e1/df/cf/ff

! Set depth to make transparency work.
URxvt*depth: 32
