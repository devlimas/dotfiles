! X colors.
! Generated by 'wal'
*foreground:        #a2c0bf
*background:        #071516
*.foreground:       #a2c0bf
*.background:       #071516
emacs*foreground:   #a2c0bf
emacs*background:   #071516
URxvt*foreground:   #a2c0bf
XTerm*foreground:   #a2c0bf
UXTerm*foreground:  #a2c0bf
URxvt*background:   [100]#071516
XTerm*background:   #071516
UXTerm*background:  #071516
URxvt*cursorColor:  #a2c0bf
XTerm*cursorColor:  #a2c0bf
UXTerm*cursorColor: #a2c0bf
URxvt*borderColor:  [100]#071516

! Colors 0-15.
*.color0: #071516
*color0:  #071516
*.color1: #1A6558
*color1:  #1A6558
*.color2: #286A55
*color2:  #286A55
*.color3: #267366
*color3:  #267366
*.color4: #308771
*color4:  #308771
*.color5: #4D916E
*color5:  #4D916E
*.color6: #627C84
*color6:  #627C84
*.color7: #a2c0bf
*color7:  #a2c0bf
*.color8: #718685
*color8:  #718685
*.color9: #1A6558
*color9:  #1A6558
*.color10: #286A55
*color10:  #286A55
*.color11: #267366
*color11:  #267366
*.color12: #308771
*color12:  #308771
*.color13: #4D916E
*color13:  #4D916E
*.color14: #627C84
*color14:  #627C84
*.color15: #a2c0bf
*color15:  #a2c0bf

! Black color that will not be affected by bold highlighting.
*.color66: #071516
*color66:  #071516

! Xclock colors.
XClock*foreground: #a2c0bf
XClock*background: #071516
XClock*majorColor:  rgba:a2/c0/bf/ff
XClock*minorColor:  rgba:a2/c0/bf/ff
XClock*hourColor:   rgba:a2/c0/bf/ff
XClock*minuteColor: rgba:a2/c0/bf/ff
XClock*secondColor: rgba:a2/c0/bf/ff

! Set depth to make transparency work.
URxvt*depth: 32
